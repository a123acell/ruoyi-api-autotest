# 若依接口自动化测试 —— 环境变量模板
#
# 用法：复制本文件为 .env，按自己的环境改值即可；.env 已被 .gitignore 排除，不会提交。
# 所有变量都有内置默认值（见 config.py），本文件只是把「可配置项」集中列出来，
# 便于在不同环境（本地 / CI / 测试服务器）之间切换，无需改动任何代码。
#
# 说明：下面留空的密码类变量，请填自己环境的真实值，不要写进代码或提交到仓库。

# ---------- 被测服务 ----------
# 后端接口地址
RY_BASE_URL=http://localhost:8080
# 请求层默认超时（秒）
RY_TIMEOUT=10

# ---------- Redis（存放图形验证码明文，用于「万能验证码」自动登录）----------
RY_REDIS_HOST=localhost
RY_REDIS_PORT=6380
RY_REDIS_DB=0

# ---------- MySQL（用于数据一致性校验）----------
RY_MYSQL_HOST=localhost
RY_MYSQL_PORT=3306
RY_MYSQL_USER=root
RY_MYSQL_PASSWORD=
RY_MYSQL_DB=ry-vue

# ---------- 账号 ----------
# 管理员账号（登录用它拿 Token）
RY_ADMIN_USERNAME=admin
RY_ADMIN_PASSWORD=
# 零权限访客账号（用于 403 越权测试）
RY_GUEST_USERNAME=guest
RY_GUEST_PASSWORD=

# ---------- 角色标识 ----------
# 按 role_key 反查 role_id，避免把自增主键写死在用例里
RY_ADMIN_ROLE_KEY=admin
RY_GUEST_ROLE_KEY=guest
# 有实际菜单授权的普通角色，用于「角色-菜单落库交叉校验」（DB-003）
RY_COMMON_ROLE_KEY=common

# ---------- 写接口正向链路用例的探针数据（仅测试数据，非真实凭据）----------
RY_PROBE_USERNAME=probe_crud_user
RY_PROBE_NICKNAME=正向链路探针
RY_PROBE_PASSWORD=Probe@12345
RY_PROBE_WEAK_PASSWORD=1234
RY_PROBE_ROLE_KEY=probe_crud_role
RY_PROBE_ROLE_NAME=正向链路探针角色
RY_PROBE_POST_CODE=probe_crud_post
RY_PROBE_POST_NAME=正向链路探针岗位
RY_PROBE_DEPT_NAME=正向链路探针部门
RY_PROBE_DEPT_PARENT_NAME=正向链路探针父部门

# ---------- 性能基线（A6：响应时间阈值断言）----------
# 单个接口响应时间上限（毫秒），超过即判定为性能回归
RY_MAX_RESPONSE_MS=1000